# USB-C LIFELINE. Deliberately NOT NetworkManager: this must keep working when
# Wi-Fi or NetworkManager do not. Same address stock AbletonOS uses, so the Mac
# reaches the Move at 172.16.254.1 whichever system is running.
[Match]
Name=usb0

[Link]
RequiredForOnline=no

[Network]
Address=172.16.254.1/24
DHCPServer=yes
LinkLocalAddressing=ipv6
ConfigureWithoutCarrier=yes
IgnoreCarrierLoss=yes

[DHCPServer]
PoolOffset=10
PoolSize=40
EmitDNS=no
EmitRouter=no
