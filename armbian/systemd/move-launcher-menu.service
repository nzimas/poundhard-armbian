[Unit]
Description=Move appliance launcher (menu on the device display)
After=sound.target
Wants=move-rt-tune.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/data/UserData/poundhard/lib:/data/UserData/rnbo/lib
WorkingDirectory=/opt/move-launcher
ExecStart=/usr/bin/python3 -u /opt/move-launcher/launcher.py
KillMode=process
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
